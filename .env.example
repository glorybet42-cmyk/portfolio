# Пример конфигурации. Скопируйте в .env и заполните реальными значениями.

# Логин администратора (по умолчанию: admin)
ADMIN_LOGIN=admin

# SHA-256 хэш пароля администратора
# Сгенерировать: python -c "import hashlib; print(hashlib.sha256(b'ваш_пароль').hexdigest())"
ADMIN_PASSWORD_HASH=замените_на_sha256_хэш

# Секретный ключ для подписи cookie-токенов (32+ hex-символов)
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замените_на_случайный_ключ